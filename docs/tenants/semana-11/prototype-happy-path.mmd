flowchart TD
    %% HAPPY PATH: Login → MFA → Dashboard → Admin → Force-Revoke
    
    START((INICIO))
    
    %% LOGIN
    LOGIN[/auth/login<br/>Email + Password]
    LOGIN_VALID{Validación<br/>Cliente + Servidor}
    LOGIN_FAIL[❌ Error: Credenciales inválidas<br/>Toast + Contador intentos]
    
    %% TENANT CHECK
    TENANT_CHECK{Tenant Activo\n+ Cupo Disponible}
    TENANT_INACTIVE[❌ Tenant Inactivo]
    TENANT_QUOTA[❌ Cupo Excedido]
    
    %% MFA
    MFA_POLICY{MFA Requerido?\nRol + Tenant Policy}
    MFA_CHALLENGE[MFA Challenge<br/>TOTP / WebAuthn]
    MFA_VERIFY{MFA Válido?}
    MFA_FAIL[❌ MFA Inválido<br/>Contador + Lockout 30min]
    MFA_LOCK[🔒 MFA Bloqueado 30min]
    
    %% TOKENS
    TOKEN_GEN[Generar Tokens<br/>Access JWT RS256 15min<br/>Refresh Opaco 7d + Rotación]
    SINGLE_SESSION{Single Session\nPolicy Activo?}
    REVOKE_PREV[Revocar Sesión Previa<br/>Blocklist + DEL Redis]
    
    %% DASHBOARD
    DASHBOARD[Dashboard Role-Based<br/>Paciente / Clínico / Admin]
    
    %% ADMIN FLOW
    ADMIN_NAV[Admin Panel → Gestión Usuarios]
    USER_LIST[Lista Usuarios\nTabla + Filtros + Paginación]
    USER_ACTION[Click [⋮] → Revocar Sesiones]
    FORCE_REVOKE_CONFIRM{Paso 1: Confirmar<br/>3 sesiones activas}
    FORCE_REVOKE_EXECUTE{Paso 2: Motivo + Comentario<br/>REVOCAR AHORA}
    REVOKE_EXEC[Ejecutar Revocación<br/>Blocklist + DEL Redis + Eventos]
    TOAST_SUCCESS[✅ Toast Éxito<br/>3 sesiones revocadas]
    UNDO_TOAST[↩️ Toast "Deshacer 5s"<br/>Click → Restaurar Sesiones]
    AUDIT_LOG[Audit Log: REVOKE_SESSION\nforce_revoke + requester_id]
    EVENT_PUBLISH[Event: SessionRevokedEvent\n→ Clinical/Governance]
    
    %% AUDIT FLOW
    AUDIT_NAV[Auditoría → Logs]
    AUDIT_FILTERS[Filtros: Fecha + Usuario + Evento + Severidad]
    AUDIT_TABLE[Tabla Expansible<br/>Expandible ▶]
    AUDIT_DETAIL[Detalle Evento<br/>Hash Chain + Acciones]
    AUDIT_EXPORT[Exportar CSV/JSON/PDF]
    
    %% CONNECTIONS
    START --> LOGIN
    LOGIN --> LOGIN_VALID
    LOGIN_VALID -->|Inválidas| LOGIN_FAIL
    LOGIN_FAIL --> LOGIN
    LOGIN_VALID -->|Válidas| TENANT_CHECK
    TENANT_CHECK -->|Inactivo| TENANT_INACTIVE
    TENANT_INACTIVE --> LOGIN
    TENANT_CHECK -->|Sin Cupo| TENANT_QUOTA
    TENANT_QUOTA --> LOGIN
    TENANT_CHECK -->|OK| MFA_POLICY
    MFA_POLICY -->|Sí| MFA_CHALLENGE
    MFA_POLICY -->|No| TOKEN_GEN
    MFA_CHALLENGE --> MFA_VERIFY
    MFA_VERIFY -->|Inválido| MFA_FAIL
    MFA_FAIL -->|< 3| MFA_CHALLENGE
    MFA_FAIL -->|3| MFA_LOCK[🔒 Bloqueado 30min]
    MFA_LOCK --> MFA_CHALLENGE
    MFA_VERIFY -->|Válido| TOKEN_GEN
    MFA_POLICY -->|No| TOKEN_GEN
    TOKEN_GEN --> SINGLE_SESSION
    SINGLE_SESSION -->|Sí| REVOKE_PREV
    REVOKE_PREV --> TOKEN_RESPONSE
    SINGLE_SESSION -->|No| TOKEN_RESPONSE
    TOKEN_RESPONSE --> DASHBOARD
    
    DASHBOARD --> ADMIN_NAV
    ADMIN_NAV --> USER_LIST
    USER_LIST --> USER_ACTION
    USER_ACTION --> FORCE_REVOKE_CONFIRM
    FORCE_REVOKE_CONFIRM -->|Cancelar| USER_LIST
    FORCE_REVOKE_CONFIRM -->|Continuar| FORCE_REVOKE_EXECUTE
    FORCE_REVOKE_EXECUTE -->|Cancelar| USER_LIST
    FORCE_REVOKE_CONFIRM -->|Continuar| FORCE_REVOKE_EXECUTE
    FORCE_REVOKE_EXECUTE --> REVOKE_EXEC
    REVOKE_EXEC --> TOAST_SUCCESS
    TOAST_SUCCESS --> UNDO_TOAST
    UNDO_TOAST -->|Click Deshacer| SESSION_RESTORED
    SESSION_RESTORED --> AUDIT_LOG
    UNDO_TOAST -->|5s expirar| AUDIT_LOG
    TOAST_SUCCESS --> AUDIT_LOG
    AUDIT_LOG --> EVENT_PUBLISH
    
    %% AUDIT FLOW
    DASHBOARD --> AUDIT_NAV
    AUDIT_NAV --> AUDIT_FILTERS
    AUDIT_FILTERS --> AUDIT_TABLE
    AUDIT_TABLE --> AUDIT_DETAIL
    AUDIT_DETAIL --> SIEM_LINK
    AUDIT_DETAIL --> JIRA_TICKET
    AUDIT_DETAIL --> EXPORT_JSON
    AUDIT_TABLE --> EXPORT_DIALOG
    
    %% STYLES
    classDef start fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef process fill:#e8f5e9,stroke:#2e7d32
    classDef decision fill:#fff3e0,stroke:#e65100
    classDef success fill:#e8f5e9,stroke:#2e7d32
    classDef error fill:#ffebee,stroke:#c62828
    classDef admin fill:#f3e5f5,stroke:#7b1fa2
    classDef audit fill:#fce4ec,stroke:#c62828
    classDef ui fill:#e3f2fd,stroke:#1565c0
    
    class START start
    class LOGIN,TENANT_CHECK,MFA_CHALLENGE,TOKEN_GEN,REVOKE_PREV,TOKEN_RESPONSE,DASHBOARD,ADMIN_NAV,USER_LIST,USER_ACTION,FORCE_REVOKE_CONFIRM,FORCE_REVOKE_EXECUTE,REVOKE_EXEC,TOAST_SUCCESS,UNDO_TOAST,AUDIT_LOG,EVENT_PUBLISH,AUDIT_NAV,AUDIT_FILTERS,AUDIT_TABLE,AUDIT_DETAIL,EXPORT_DIALOG process
    class MFA_POLICY,SINGLE_SESSION,FORCE_REVOKE_CONFIRM decision
    class LOGIN_FAIL,TENANT_INACTIVE,TENANT_QUOTA,MFA_FAIL,MFA_LOCK error
    class LOGIN,TENANT_CHECK,MFA_CHALLENGE,TOKEN_GEN,REVOKE_PREV,TOKEN_RESPONSE,DASHBOARD,ADMIN_NAV,USER_LIST,USER_ACTION,FORCE_REVOKE_CONFIRM,FORCE_REVOKE_EXECUTE,REVOKE_EXEC,TOAST_SUCCESS,UNDO_TOAST,AUDIT_LOG,EVENT_PUBLISH,AUDIT_NAV,AUDIT_FILTERS,AUDIT_TABLE,AUDIT_DETAIL,EXPORT_DIALOG ui
    class ADMIN_NAV,USER_LIST,USER_ACTION,FORCE_REVOKE_CONFIRM,FORCE_REVOKE_EXECUTE,REVOKE_EXEC admin
    class AUDIT_NAV,AUDIT_FILTERS,AUDIT_TABLE,AUDIT_DETAIL,EXPORT_DIALOG audit