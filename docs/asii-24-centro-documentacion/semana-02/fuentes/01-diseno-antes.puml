@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #263238
skinparam class {
  BackgroundColor #FFEBEE
  BorderColor #C62828
  FontColor #17212B
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B8860B
  FontColor #17212B
}

interface RepositorioDocumentosGordo {
  + publicar(documento): void
  + clasificar(id, roles): void
  + listar(rol): array
  + buscar(texto): array
  + descargar(id): archivo
  + versionar(id): void
  + eliminar(id): void
}
class CatalogoController
class ResponsableController
class DescargaController

CatalogoController ..|> RepositorioDocumentosGordo : implementa 7 metodos
ResponsableController ..|> RepositorioDocumentosGordo : implementa 7 metodos
DescargaController ..|> RepositorioDocumentosGordo : implementa 7 metodos

note right of RepositorioDocumentosGordo
  Interfaz "gorda": obliga a todo
  cliente a implementar metodos que
  no usa (publicar, descargar,
  versionar, eliminar).
end note
note bottom of CatalogoController
  Solo necesita listar() y buscar(),
  pero debe declarar 5 metodos ajenos.
end note
@enduml
