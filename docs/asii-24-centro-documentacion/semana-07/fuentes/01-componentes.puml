@startuml
title ASII-24 - Componentes backend y frontend
skinparam componentStyle uml2
package "Frontend (Vue 3 + Pinia)" #Paleturquoise {
  [CentroDocumentacionView.vue] as fe0
  [DocumentoCard.vue] as fe1
  [PublicarDocumentoForm.vue] as fe2
  [useDocumentosStore (Pinia)] as fe3
  [documentosApi.js (Axios)] as fe4
}
package "Backend (Laravel / Micro-HIS)" #LightYellow {
  [DocumentoController] as be0
  [PublicarDocumento] as be1
  [ConsultarDocumentos] as be2
  [Documento (entidad)] as be3
  [DocumentoRepository (interfaz)] as be4
  [DocumentoRepositoryPDO] as be5
}
interface "API REST /api/v1/documentos\n(contrato Semana 5)" as api
fe0 --> fe1
fe1 --> fe2
fe2 --> fe3
fe3 --> fe4
be0 --> be1
be1 --> be2
be2 --> be3
be3 --> be4
be4 --> be5
fe4 ..> api : JSON + JWT + X-Tenant-ID
api - be0
@enduml
