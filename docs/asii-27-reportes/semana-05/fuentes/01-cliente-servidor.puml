@startuml
title Micro-HIS Reportes exportables (ASII-27) - Cliente-servidor, API REST e integracion
skinparam componentStyle rectangle
[SPA Vue 3 / Postman] as spa
[API Gateway (ASII-30)\nJWT + X-Tenant-ID] as gw
node "Servidor Micro-HIS ASII-27" {
  [Router REST /api/v1] as router
  [ReporteController (Semana 4)] as ctrl
  [Casos de uso] as uc
  [ReporteRepository (interfaz)] as repo
  [ReporteRepositoryPDO] as pdo
}
database "BD del modulo\n(por tenant)" as db
spa --> gw : HTTPS + JSON
gw --> router : /api/v1/reportes
router --> ctrl
ctrl --> uc
uc --> repo
pdo ..|> repo
pdo --> db
[ASII-05 Citas API] as citas
[ASII-09 Ocupacion API] as ocu
uc ..> citas : contrato HTTP\n(fuente)
uc ..> ocu : contrato HTTP\n(fuente)
@enduml
