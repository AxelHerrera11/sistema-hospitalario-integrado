flowchart TD
    %% ENTRY POINTS
    ENTRY((ENTRY POINT<br/>/auth/login))
    
    %% AUTH FLOW
    LOGIN[LOGIN<br/>Email + Password]
    MFA[MFA CHALLENGE<br/>TOTP / WebAuthn]
    FORGOT[FORGOT PASSWORD<br/>/forgot-password]
    MFA_RECOVERY[MFA RECOVERY<br/>/mfa/recovery]
    
    %% AUTH RESULTS
    LOGIN_SUCCESS{Login Success?}
    MFA_SUCCESS{MFA Valid?}
    
    %% DASHBOARDS
    DASHBOARD[DASHBOARD<br/>Role-based UI]
    
    %% PATIENT FLOW
    PATIENT_DASH[PATIENT DASHBOARD<br/>Resumen Citas/Meds/Resultados]
    PATIENT_APPT[CITAS<br/>Lista + Detalle + Cancelar]
    PATIENT_MEDS[MEDICACIÓN<br/>Lista + Recordatorios]
    PATIENT_RECORDS[EXPEDIENTE<br/>Resultados + Resumen]
    PATIENT_SECURITY[SEGURIDAD<br/>MFA Setup + Dispositivos]
    
    %% CLINICAL FLOW
    CLINICAL_DASH[CLINICAL DASHBOARD<br/>Pacientes + Citas]
    PATIENT_LIST[LISTA PACIENTES<br/>Búsqueda + Filtros]
    PATIENT_RECORD[EXPEDIENTE CLÍNICO<br/>Notas + Estudios + Break-Glass]
    APPOINTMENTS[CITAS CLÍNICAS<br/>Agenda + Check-in]
    
    %% ADMIN FLOW
    ADMIN_DASH[ADMIN PANEL<br/>Sidebar + Content]
    USER_LIST[LISTA USUARIOS<br/>Tabla + Filtros + Acciones]
    CREATE_USER[CREAR USUARIO<br/>Wizard 3 pasos]
    USER_DETAIL[DETALLE USUARIO<br/>Editar + Roles + Sesiones]
    FORCE_REVOKE[FORCE REVOKE<br/>Modal 2-paso + Deshacer]
    TENANT_MGR[GESTIÓN TENANTS<br/>CRUD + Políticas]
    
    %% AUDIT FLOW
    AUDIT_LOGS[AUDITORÍA<br/>Tabla + Filtros + Export]
    AUDIT_DETAIL[DETALLE EVENTO<br/>Hash Chain + Acciones]
    EXPORT_DIALOG[EXPORTAR<br/>CSV/JSON/PDF]
    
    %% SECURITY
    SECURITY_INCIDENT[INCIDENTE SEGURIDAD<br/>Modal Crítico Full-screen]
    RELOGIN[RE-LOGIN FORZADO<br/>Post-Revocación Total]
    
    %% SETTINGS
    PROFILE[PERFIL<br/>Datos + Avatar]
    SECURITY_SETTINGS[SEGURIDAD<br/>MFA + Dispositivos + Sesiones]
    NOTIFICATIONS[NOTIFICACIONES<br/>Email + Push + In-app]
    
    %% CONNECTIONS
    ENTRY --> LOGIN
    LOGIN --> LOGIN_SUCCESS
    LOGIN --> FORGOT
    LOGIN --> MFA_RECOVERY
    
    LOGIN_SUCCESS -->|Credenciales OK| MFA
    LOGIN_SUCCESS -->|Sin MFA req| DASHBOARD
    
    MFA --> MFA_SUCCESS
    MFA -->|Código inválido| MFA
    MFA -->|3 fallos| MFA_LOCKED[MFA BLOQUEADO 30min]
    
    MFA_SUCCESS --> DASHBOARD
    FORGOT --> PASSWORD_RESET[RESET PASSWORD]
    MFA_RECOVERY --> MFA_SETUP[CONFIGURAR NUEVO MFA]
    
    DASHBOARD --> PATIENT_DASH
    DASHBOARD --> CLINICAL_DASH
    DASHBOARD --> ADMIN_DASH
    
    %% PATIENT NAV
    PATIENT_DASH --> PATIENT_APPT
    PATIENT_DASH --> PATIENT_MEDS
    PATIENT_DASH --> PATIENT_RECORDS
    PATIENT_DASH --> PATIENT_SECURITY
    
    PATIENT_APPT --> APPT_DETAIL[DETALLE CITA]
    APPT_DETAIL --> APPT_CANCEL[CANCELAR CITA]
    APPT_DETAIL --> APPT_RESCHEDULE[REPROGRAMAR]
    
    PATIENT_MEDS --> MED_DETAIL[DETALLE MEDICAMENTO]
    
    PATIENT_RECORDS --> RECORD_DETAIL[DETALLE RESULTADO]
    
    PATIENT_SECURITY --> MFA_SETUP_WIZARD[CONFIGURAR MFA<br/>Wizard 3 pasos]
    PATIENT_SECURITY --> DEVICE_MGR[DISPOSITIVOS<br/>Revoke + Renombrar]
    
    %% CLINICAL NAV
    CLINICAL_DASH --> PATIENT_LIST
    CLINICAL_DASH --> APPOINTMENTS
    CLINICAL_DASH --> BREAK_GLASS[BREAK-GLASS<br/>Emergencia]
    
    PATIENT_LIST --> PATIENT_RECORD
    PATIENT_RECORD --> BREAK_GLASS
    
    APPOINTMENTS --> APPT_CHECKIN[CHECK-IN PACIENTE]
    
    %% ADMIN NAV
    ADMIN_DASH --> USER_LIST
    ADMIN_DASH --> TENANT_MGR
    ADMIN_DASH --> AUDIT_LOGS
    
    USER_LIST --> CREATE_USER
    USER_LIST --> USER_DETAIL
    USER_DETAIL --> FORCE_REVOKE
    USER_DETAIL --> EDIT_USER
    USER_DETAIL --> BLOCK_USER
    
    CREATE_USER --> USER_LIST
    EDIT_USER --> USER_LIST
    BLOCK_USER --> USER_LIST
    FORCE_REVOKE --> USER_LIST
    
    TENANT_MGR --> CREATE_TENANT[CREAR TENANT]
    CREATE_TENANT --> TENANT_MGR
    
    %% AUDIT NAV
    ADMIN_DASH --> AUDIT_LOGS
    AUDIT_LOGS --> AUDIT_DETAIL
    AUDIT_LOGS --> EXPORT_DIALOG
    AUDIT_DETAIL --> SIEM_LINK[VER EN SIEM]
    AUDIT_DETAIL --> JIRA_TICKET[CREAR JIRA]
    
    %% SECURITY FLOW
    REFRESH_REUSE[REFRESH REUSE DETECTED] --> REVOKE_ALL[REVOCACIÓN TOTAL]
    REVOKE_ALL --> BLOCKLIST[BLOCKLIST TOKENS]
    REVOKE_ALL --> DELETE_REFRESH[DELETE REFRESH TOKENS]
    REVOKE_ALL --> SIEM_ALERT[ALERTA SIEM]
    REVOKE_ALL --> JIRA_TICKET_SEC[JIRA AUTO]
    REVOKE_ALL --> RELOGIN
    
    RELOGIN --> LOGIN
    
    %% SETTINGS
    DASHBOARD --> PROFILE
    DASHBOARD --> SECURITY_SETTINGS
    DASHBOARD --> NOTIFICATIONS
    
    SECURITY_SETTINGS --> MFA_SETUP
    SECURITY_SETTINGS --> DEVICE_MGR
    SECURITY_SETTINGS --> SESSION_MGR
    
    %% AUTH FLOW DETAILS
    LOGIN -->|Credenciales inválidas| LOGIN_ERROR[ERROR: Credenciales inválidas]
    LOGIN -->|Cuenta bloqueada| ACCOUNT_LOCKED[CUENTA BLOQUEADA]
    LOGIN -->|Tenant inactivo| TENANT_INACTIVE[TENANT INACTIVO]
    
    MFA -->|Código inválido| MFA_ERROR
    MFA -->|3 fallos| MFA_LOCKED
    
    MFA_RECOVERY --> TOTP_RECOVERY[RECUPERAR TOTP]
    MFA_RECOVERY --> WEBAUTHN_RECOVERY[RECUPERAR WEBAUTHN]
    MFA_RECOVERY --> ADMIN_HELP[CONTACTAR ADMIN]
    
    %% FORCE REVOKE DETAIL
    FORCE_REVOKE --> CONFIRM_STEP[PASO 1: CONFIRMAR]
    CONFIRM_STEP --> EXECUTE_STEP[PASO 2: EJECUTAR + MOTIVO]
    EXECUTE_STEP --> TOAST_SUCCESS
    TOAST_SUCCESS --> UNDO_ACTION[DESHACER 5s]
    UNDO_ACTION --> SESSION_RESTORED
    
    %% AUDIT DETAIL
    AUDIT_DETAIL --> SIEM_LINK
    AUDIT_DETAIL --> JIRA_TICKET
    AUDIT_DETAIL --> EXPORT_JSON
    AUDIT_DETAIL --> NOTIFY_USER
    
    %% REFRESH REUSE FLOW
    REFRESH_REUSE --> REVOKE_ALL
    REVOKE_ALL --> BLOCKLIST
    REVOKE_ALL --> DELETE_REFRESH
    REVOKE_ALL --> SIEM_ALERT
    REVOKE_ALL --> JIRA_TICKET_SEC
    REVOKE_ALL --> RELOGIN
    
    RELOGIN --> LOGIN
    RELOGIN --> MFA
    RELOGIN --> DASHBOARD

    %% STYLING
    classDef entry fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef auth fill:#e3f2fd,stroke:#1565c0
    classDef success fill:#e8f5e9,stroke:#2e7d32
    classDef error fill:#ffebee,stroke:#c62828
    classDef warning fill:#fff3e0,stroke:#e65100
    classDef critical fill:#ffebee,stroke:#c62828,stroke-width:3px
    classDef admin fill:#f3e5f5,stroke:#7b1fa2
    classDef patient fill:#e8f5e9,stroke:#2e7d32
    classDef clinical fill:#fff3e0,stroke:#e65100
    classDef audit fill:#fce4ec,stroke:#c62828
    classDef security fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef settings fill:#f5f5f5,stroke:#757575
    
    class ENTRY entry
    class LOGIN,FORGOT,MFA,MFA_RECOVERY,LOGIN_ERROR,ACCOUNT_LOCKED,TENANT_INACTIVE,MFA_ERROR,MFA_LOCKED,MFA_RECOVERY auth
    class LOGIN_SUCCESS,MFA_SUCCESS,PASSWORD_RESET,MFA_SETUP,MFA_SETUP_WIZARD success
    class LOGIN_ERROR,ACCOUNT_LOCKED,TENANT_INACTIVE,MFA_ERROR,MFA_LOCKED error
    class DASHBOARD,PATIENT_DASH,CLINICAL_DASH,ADMIN_DASH success
    class PATIENT_DASH,PATIENT_APPT,PATIENT_MEDS,PATIENT_RECORDS,PATIENT_SECURITY,APPT_DETAIL,MED_DETAIL,RECORD_DETAIL,PATIENT_SECURITY,MFA_SETUP_WIZARD,DEVICE_MGR patient
    class CLINICAL_DASH,PATIENT_LIST,PATIENT_RECORD,APPOINTMENTS,APPT_DETAIL,APPT_CHECKIN,BREAK_GLASS clinical
    class ADMIN_DASH,USER_LIST,CREATE_USER,USER_DETAIL,FORCE_REVOKE,TENANT_MGR,CREATE_TENANT,EDIT_USER,BLOCK_USER admin
    class AUDIT_LOGS,AUDIT_DETAIL,EXPORT_DIALOG,SIEM_LINK,JIRA_TICKET audit
    class REFRESH_REUSE,REVOKE_ALL,BLOCKLIST,DELETE_REFRESH,SIEM_ALERT,JIRA_TICKET_SEC,RELOGIN,SECURITY_INCIDENT,RELOGIN critical
    class PROFILE,SECURITY_SETTINGS,NOTIFICATIONS,MFA_SETUP,DEVICE_MGR,SESSION_MGR,MFA_SETUP_WIZARD settings
    class MFA,SECURITY_INCIDENT,RELOGIN security
    class FORCE_REVOKE,CONFIRM_STEP,EXECUTE_STEP,TOAST_SUCCESS,UNDO_ACTION,SESSION_RESTORED security
    class AUDIT_DETAIL,SIEM_LINK,JIRA_TICKET,EXPORT_JSON,NOTIFY_USER audit
    class REFRESH_REUSE,REVOKE_ALL,BLOCKLIST,DELETE_REFRESH,SIEM_ALERT,JIRA_TICKET_SEC,RELOGIN security