@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #263238
skinparam actor {
  BorderColor #263238
  FontColor #263238
}
skinparam usecase {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #17212B
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B8860B
  FontColor #17212B
}

actor "Responsable de documentación" as R
actor "Usuario por rol\n(médico, enfermería,\nrecepción, admin)" as U
actor "Servicio de autenticación\ny autorización (JWT)" as Auth
rectangle "ASII-24 · Centro de documentación y manuales por rol" {
  usecase "CU-01\nPublicar documento o manual" as C1
  usecase "CU-02\nClasificar por rol\ny catálogo" as C2
  usecase "CU-03\nConsultar documentación\nsegún rol" as C3
  usecase "CU-04\nBuscar y filtrar\ndocumentos" as C4
  usecase "CU-05\nDescargar documento" as C5
  usecase "CU-06\nGestionar versiones\ny vigencia" as C6
  usecase "Validar sesión, rol y tenant" as Guard
}

R --> C1
R --> C2
R --> C6
U --> C3
U --> C4
U --> C5
C1 .> C2 : <<include>>
C1 .> Guard : <<include>>
C3 .> Guard : <<include>>
C3 .> C4 : <<extend>>\n[buscar]
C3 .> C5 : <<extend>>\n[descargar]
C3 .> C6 : <<extend>>\n[ver vigencia]

note bottom of C3
  El catálogo visible se filtra por el
  rol del usuario: cada rol solo ve la
  documentación que le corresponde.
end note
@enduml
