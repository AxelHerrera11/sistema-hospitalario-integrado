@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #263238
skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #17212B
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B8860B
  FontColor #17212B
}

interface ReportDefinition {
  + id(): string
  + permiso(): string
  + filtros(): array
  + columnas(): array
  + filas(filtros: array): iterable
}
interface ReportFilter {
  + soporta(clave: string): bool
  + aplicar(consulta, valor): consulta
}
interface ReportExporter {
  + soporta(formato: string): bool
  + exportar(definicion: ReportDefinition, filas: iterable, recurso): void
}
class CitasReportDefinition implements ReportDefinition
class OcupacionReportDefinition implements ReportDefinition
class FiltroPorRangoFecha implements ReportFilter
class FiltroPorEstado implements ReportFilter
class FiltroPorSala implements ReportFilter
class CsvReportExporter implements ReportExporter
class PdfReportExporter implements ReportExporter
class ReportesService {
  - reportes: iterable<ReportDefinition>
  - filtros: iterable<ReportFilter>
  - exportadores: iterable<ReportExporter>
  + exportar(id: string, filtros: array, formato: string): string
  - resolverReporte(id: string): ReportDefinition
  - resolverExportador(formato: string): ReportExporter
}
class ReportesServiceProvider {
  + register(): void
}
class ReportesController {
  + export(request): respuesta
}
ReportesService o-- "1..*" ReportDefinition : abstracción
ReportesService o-- "0..*" ReportFilter : abstracción
ReportesService o-- "1..*" ReportExporter : abstracción
ReportesServiceProvider ..> ReportesService : construye e inyecta
ReportesServiceProvider ..> ReportFilter : registra
ReportesServiceProvider ..> ReportExporter : registra
ReportesController --> ReportesService
note right of ReportesService
  Cerrado: no cambia al agregar
  un reporte, filtro o formato.
end note
note bottom of CitasReportDefinition
  Reporte nuevo = clase nueva + registro.
end note
note bottom of PdfReportExporter
  Formato nuevo sin tocar el CSV.
end note
@enduml
