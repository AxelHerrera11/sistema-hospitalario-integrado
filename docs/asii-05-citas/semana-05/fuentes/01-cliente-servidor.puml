@startuml
title Micro-HIS Citas (ASII-05) - Cliente-servidor, API REST e integracion
skinparam componentStyle rectangle
[SPA Vue 3 / Postman] as spa
[API Gateway (ASII-30)\nJWT + X-Tenant-ID] as gw
node "Servidor Micro-HIS ASII-05" {
  [Router REST /api/v1] as router
  [CitaController (Semana 4)] as ctrl
  [Casos de uso] as uc
  [CitaRepository (interfaz)] as repo
  [CitaRepositoryPDO] as pdo
}
database "BD del modulo\n(por tenant)" as db
spa --> gw : HTTPS + JSON
gw --> router : /api/v1/citas
router --> ctrl
ctrl --> uc
uc --> repo
pdo ..|> repo
pdo --> db
[ASII-03 Pacientes API] as pac
[ASII-04 Medicos API] as med
[ASII-27 Reportes] as rep
uc ..> pac : contrato HTTP\n(existe paciente)
uc ..> med : contrato HTTP\n(disponibilidad)
rep --> gw : GET /citas
@enduml
