@startuml
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title **C4 Container Diagram: Módulo Tenants & Auth - Vista de Contenedores**\n(Semana 03 | Versión 1.0)
Person(admin, "Admin Tenant / Platform Admin")
Person(user, "Usuario Final (Clínico/Admin)")
System_Boundary(tenants_auth, "Módulo Tenants & Auth") {
    Container(auth_api, "Auth API\n(Presentation Layer)", "PHP 8.2+ / Slim / FastRoute", "Expone endpoints REST: /auth/*, /admin/users/*, /admin/tenants/*\nValida HTTP, serializa JSON, maneja errores → Application Layer")
    Container(use_cases, "Application Layer\n(Use Cases)", "PHP 8.2+ / Clases puras", "Orquesta flujos: RegisterUser, AuthenticateUser, RevokeSession, RefreshToken\nCoordinación: Domain Services + Repository Interfaces + Domain Events")
    Container(domain, "Domain Layer\n(Núcleo)", "PHP 8.2+ / Sin dependencias externas", "Entidades: User, Tenant, Session, RefreshToken\nValue Objects: Email, Password, JwtClaims, Role, TenantId\nDomain Services: PasswordPolicy, MfaPolicy, TokenFactory, RefreshTokenRotator\nRepository Interfaces (Puertos): UserRepo, TenantRepo, SessionRepo, RefreshTokenRepo, AuditLogRepo\nDomain Events: UserCreated, UserLoggedIn, SessionRevoked, MfaChallenged, RefreshReuseDetected")
    ContainerDb(db_central, "PostgreSQL Central\n(his_central)", "PostgreSQL 15+ / RLS", "Tablas: central_users, hospital_memberships, patient_consents,\ncross_hospital_access_grants, cross_hospital_access_audits,\naudit_log (append-only + hash chain)")
    ContainerDb(db_hospital, "PostgreSQL Hospital\n(his_hospital)", "PostgreSQL 15+ / RLS", "Configuración por tenant, políticas, datos clínicos (RLS por tenant_id)")
    Container(redis, "Redis Cluster", "Redis 7+ / TLS", "Estructuras:\n- refresh:{user_id}:{device_id} → {hash, jti_access, exp} (TTL 7d)\n- session:{session_id} → {user_id, tenant_id, device_id, last_activity} (TTL 7d)\n- blocklist:{jti} → exp_timestamp (TTL = exp-now)\n- login_failures:{user_id} → count (TTL 15m)\n- mfa_failures:{user_id} → count (TTL 30m)\n- account_lock:{user_id} → locked (TTL variable)\n- login_attempts:{email}:{IP} → count (TTL 15m)")
    Container(jwt_service, "JWT Token Service\n(Infrastructure)", "PHP 8.2+ / lcobucci/jwt", "Firma/valida JWT RS256\nJWKS rotation (24h)\nClaims: sub, roles[], tenant_id, session_id, jti, device_id, exp\nKey management: claves rotativas en vault")
    Container(mfa_service, "MFA Service\n(Infrastructure)", "PHP 8.2+ / TOTP (RFC 6238) + WebAuthn", "TOTP: Google Authenticator / Authy compatible\nWebAuthn/FIDO2: Passkeys, credential management\nChallenge generation + verification")
    Container(blocklist_svc, "Blocklist Service\n(Infrastructure)", "PHP 8.2+ / Redis", "Gestión blocklist access tokens\nSET blocklist:{jti} con TTL = exp restante\nValidación O(1) en middleware")
    Container(audit_svc, "Audit Log Service\n(Infrastructure)", "PHP 8.2+ / PostgreSQL", "Eventos append-only + hash chain SHA-256\n14 tipos: LOGIN_SUCCESS, LOGIN_FAILED, MFA_*, ACCOUNT_LOCKED,\nTOKEN_REFRESHED, REFRESH_REUSE_ATTACK, REVOKE_SESSION,\nSESSION_IDLE_TIMEOUT, CROSS_TENANT_ATTEMPT, TENANT_*, USER_*\nTrigger BEFORE UPDATE/DELETE → EXCEPTION")
    Container(email_svc, "Email / Notification\nService", "PHP 8.2+ / SMTP / Queue", "Envío credenciales temporales, alertas MFA,\nnotificaciones admin, break-glass alerts")
}
System_Ext(sso, "Proveedor SSO (SAML/OIDC)")
System_Ext(hibp, "HaveIBeenPwned API")
System_Ext(siem, "SIEM / SOC")
System_Ext(k8s, "Kubernetes / ArgoCD")
Rel(admin, auth_api, "HTTPS/REST + JWT", "JSON")
Rel(user, auth_api, "HTTPS/REST + JWT", "JSON")
Rel(auth_api, use_cases, "In-memory calls (DTOs)", "UseCase Request/Response")
Rel(use_cases, domain, "In-memory calls", "Entities, VOs, Domain Services, Events")
Rel(use_cases, db_central, "Implementa Repository Interfaces", "SQL / PDO")
Rel(use_cases, redis, "Implementa Repository Interfaces", "Redis Protocol")
Rel(use_cases, jwt_service, "Domain Service → Infrastructure", "TokenFactory interface")
Rel(use_cases, mfa_service, "Domain Service → Infrastructure", "MfaPolicy interface")
Rel(use_cases, blocklist_svc, "Domain Service → Infrastructure", "Blocklist interface")
Rel(use_cases, audit_svc, "Domain Event → Infrastructure", "AuditLogRepository interface")
Rel(use_cases, email_svc, "Domain Event → Infrastructure", "Notification interface")
Rel(jwt_service, db_central, "JWKS public keys (read)", "HTTPS")
Rel(auth_api, k8s, "Deploy / Config / Secrets", "GitOps / Helm")
Rel(auth_api, sso, "JIT Provisioning / SSO Login", "SAML 2.0 / OIDC")
Rel(domain, hibp, "PasswordPolicy → External API", "HTTPS/REST")
Rel(audit_svc, siem, "Forward security events", "Syslog / Kafka / HTTP")
@enduml
