@startuml

left to right direction

actor "Usuario autorizado" as Usuario

rectangle "ASII-03 - Gestión de Pacientes" {

    usecase "UC-PAC-01\nRegistrar paciente" as UC1

    usecase "UC-PAC-02\nBuscar paciente" as UC2

    usecase "UC-PAC-03\nConsultar detalle\nde paciente" as UC3

    usecase "UC-PAC-04\nActualizar paciente" as UC4

    usecase "UC-PAC-05\nValidar datos\ndel paciente" as UC5

    usecase "UC-PAC-06\nVerificar existencia\ndel paciente" as UC6

}

Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4

UC1 .> UC5 : <<include>>

UC3 .> UC6 : <<include>>

UC4 .> UC6 : <<include>>
UC4 .> UC5 : <<include>>

note right of UC1
El paciente solamente se
registra cuando los datos
son válidos.
end note

note right of UC4
Para actualizar se debe
verificar primero que el
paciente exista.
end note

@enduml
