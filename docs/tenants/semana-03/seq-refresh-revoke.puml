@startuml
skinparam sequenceMessageAlign center
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBackgroundColor #FFF3E0
skinparam sequenceParticipantBorderColor #E65100
skinparam sequenceActorBackgroundColor #E8F5E9
skinparam sequenceActorBorderColor #2E7D32
skinparam sequenceDatabaseBackgroundColor #FCE4EC
skinparam sequenceDatabaseBorderColor #C62828
title **Secuencia: Refresh Token Rotation, Reuse Detection y Revocación de Sesión (RF-07, RF-08, RF-09)**
actor "Cliente (App/Portal)" as Client
participant "AuthController\n(Presentation)" as Ctrl
participant "RefreshTokenUseCase\n(Application)" as UCRefresh
participant "RevokeSessionUseCase\n(Application)" as UCRevoke
participant "RefreshTokenRotator\n(Domain Service)" as Rotator
participant "TokenFactory\n(Domain Service)" as TokenFactory
participant "RedisRefreshTokenRepo\n(Infrastructure)" as RefreshRepo
participant "RedisSessionRepo\n(Infrastructure)" as SessionRepo
participant "RedisBlocklistRepo\n(Infrastructure)" as BlocklistRepo
participant "JwtTokenService\n(Infrastructure)" as JwtSvc
participant "Redis Cluster" as Redis
participant "EventPublisher" as Events
participant "AuditLogRepo" as AuditRepo

' ============ REFRESH TOKEN ============
group **Refresh Token Rotation (Happy Path)**
    Client -> Ctrl : POST /auth/refresh\n{refresh_token}
    Ctrl -> Ctrl : Validar RefreshRequest DTO
    Ctrl -> UCRefresh : execute(RefreshCommand)
    UCRefresh -> Rotator : rotate(refresh_token)
    Rotator -> Rotator : Extraer user_id, device_id del token (sin verificar)
    Rotator -> RefreshRepo : findByUserIdAndDevice(user_id, device_id)
    RefreshRepo -> Redis : GET refresh:{user_id}:{device_id}
    Redis --> RefreshRepo : {hash, jti_old_access, exp, created_at} | NULL
    alt No existe en Redis (revocado/expirado)
        Rotator -> AuditRepo : log(REFRESH_INVALID)
        Rotator --> UCRefresh : Failure(RefreshRevoked)
    else Existe
        Rotator -> Rotator : Verificar Argon2id(refresh_token) == hash
        alt Hash NO coincide → REUSE DETECTED (ATAQUE)
            Rotator -> Redis : KEYS refresh:{user_id}:*
            Redis --> Rotator : all_refresh_keys
            loop Revocar TODAS las sesiones del usuario
                Rotator -> Redis : GET key → {jti_access}
                Rotator -> BlocklistRepo : add(jti_access, exp)
                BlocklistRepo -> Redis : SET blocklist:{jti_access} TTL=exp-now
                Rotator -> RefreshRepo : delete(key)
                Rotator -> SessionRepo : delete(session_id)
            end
            Rotator -> AuditRepo : log(REFRESH_REUSE_ATTACK, severity: CRITICAL)
                Rotator -> Events : publish(SecurityAlert{user_id, type: REFRESH_REUSE
            }
            )
            Rotator --> UCRefresh : Failure(TokenCompromised)
        else Hash coincide → ROTACIÓN VÁLIDA
            Rotator -> RefreshRepo : delete(old_key)
            Rotator -> TokenFactory : createAccessToken(user, tenant, new_session_id, device_id)
            TokenFactory -> JwtSvc : sign(new_claims, RS256)
            JwtSvc --> TokenFactory : new_access_token (new_jti)
            TokenFactory --> Rotator : new_access_token

            Rotator -> Rotator : new_refresh = random(32 bytes)
            Rotator -> Rotator : new_hash = Argon2id(new_refresh)
            Rotator -> RefreshRepo : save(new_refresh_entity{user_id, device_id, new_hash, new_jti, exp: 7d
        }
        )
        RefreshRepo -> Redis : SET refresh:{
            user_id}:{
                device_id
            }
            {new_hash, new_jti, exp
        }
        EX 7d
        Redis --> RefreshRepo : OK
        Rotator -> SessionRepo : updateLastActivity(session_id, now)
        SessionRepo -> Redis : SET session:{
            session_id} {
                {last_activity: now
            }
            EX 7d
            Rotator -> AuditRepo : log(TOKEN_REFRESHED, {
                old_jti, new_jti, device_id})
                Rotator --> UCRefresh : RefreshResult {
                    new_access_token, new_refresh_token, new_expires_in}
                end
            end
            UCRefresh --> Ctrl : Resultado
            Ctrl -> Ctrl : Transformar a JSON
            Ctrl --> Client : 200 OK\n{access_token, refresh_token, expires_in: 900}
        end
        ' ============ REVOCACIÓN DE SESIÓN ============
        group **Revocación: Logout Propio**
            Client -> Ctrl : POST /auth/logout\nAuthorization: Bearer <access_token>
            Ctrl -> UCRevoke : execute(RevokeCommand{session_id, reason: "logout"
        }
        )
        UCRevoke -> BlocklistRepo : add(jti_from_token, exp)
        BlocklistRepo -> Redis : SET blocklist:{
            jti
        }
        TTL=exp-now
        UCRevoke -> RefreshRepo : deleteByUserIdAndDevice(user_id, device_id)
        RefreshRepo -> Redis : DEL refresh:{
            user_id}:{device_id
        }
        UCRevoke -> SessionRepo : delete(session_id)
        SessionRepo -> Redis : DEL session:{
            session_id}
            UCRevoke -> AuditRepo : log(REVOKE_SESSION, {reason: "logout", revoked_count: 1})
            UCRevoke -> Events : publish(SessionRevokedEvent{user_id, reason: "logout"})
            UCRevoke --> Ctrl : RevokeResult {revoked_sessions: 1}
            Ctrl --> Client : 200 OK {message: "Sesión cerrada correctamente"}
        end
        group **Revocación: Force-Revoke por Admin**
            actor "Admin Tenant" as Admin
            Admin -> Ctrl : DELETE /admin/users/{target_user_id}/sessions\nAuthorization: Bearer <admin_token>
            Ctrl -> Ctrl : Validar permisos (TENANT_ADMIN + mismo tenant)
            Ctrl -> UCRevoke : execute(RevokeCommand{target_user_id, reason: "force_revoke", requester_id: admin_id
        }
        )
        UCRevoke -> RefreshRepo : findAllByUserId(target_user_id)
        RefreshRepo -> Redis : KEYS refresh:{t
            arget_user_id
        }
        :*
        Redis --> RefreshRepo : refresh_keys[]
        loop Por cada refresh key
            UCRevoke -> RefreshRepo : get(key) → {jti_access}
            UCRevoke -> BlocklistRepo : add(jti_access, exp)
            BlocklistRepo -> Redis : SET blocklist:{jti_access} TTL=exp-now
            UCRevoke -> RefreshRepo : delete(key)
        end
        UCRevoke -> SessionRepo : findAllByUserId(target_user_id)
        SessionRepo -> Redis : KEYS session:{t
            arget_user_id}:*
            Redis --> SessionRepo : session_keys[]
            loop Por cada session
                UCRevoke -> SessionRepo : delete(session_id)
            end
            UCRevoke -> AuditRepo : log(REVOKE_SESSION, {reason: "force_revoke", requester_id: admin_id, revoked_count: N})
            UCRevoke -> Events : publish(SessionRevokedEvent{user_id: target_user_id, reason: "force_revoke", requester_id: admin_id})

            UCRevoke --> Ctrl : RevokeResult {revoked_sessions: N}
            Ctrl --> Admin : 200 OK {revoked_sessions: N}
        end
        @enduml
