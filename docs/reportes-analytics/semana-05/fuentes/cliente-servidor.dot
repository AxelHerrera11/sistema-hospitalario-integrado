  }
  central [label="CENTRAL\nidentidad, membresías", shape=cylinder, fillcolor="#ecfdf5", color="#047857"];
  hospital [label="HOSPITAL\ncare_episodes", shape=cylinder, fillcolor="#ecfdf5", color="#047857"];
