@startuml
title Integracion con un repositorio de datos compartido del HIS

skinparam componentStyle rectangle
package "Modulo Dashboard (ASII-26)" {
  [ObtenerTablero] as uc
  [IndicadorRepository (interfaz)] as repo
}
package "Modulo Citas (ASII-05)" {
  [AgendarCita] as uc05
  [CitaRepository (interfaz)] as repo05
}
package "Repositorio de datos compartido" {
  [Esquema comun (tenant, periodo, auditoria)] as esquema
  [Adaptador Dashboard] as adp26
  [Adaptador Citas] as adp05
}
uc --> repo
uc05 --> repo05
repo ..> adp26
repo05 ..> adp05
adp26 --> esquema
adp05 --> esquema
@enduml
