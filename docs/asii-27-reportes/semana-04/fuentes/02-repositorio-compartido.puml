@startuml
title Integracion con un repositorio de datos compartido del HIS

skinparam componentStyle rectangle
package "Modulo Reportes (ASII-27)" {
  [GenerarReporte] as uc
  [ReporteRepository (interfaz)] as repo
}
package "Modulo Citas (ASII-05)" {
  [AgendarCita] as uc05
  [CitaRepository (interfaz)] as repo05
}
package "Repositorio de datos compartido" {
  [Esquema comun (tenant, periodo, auditoria)] as esquema
  [Adaptador Reportes] as adp27
  [Adaptador Citas] as adp05
}
uc --> repo
uc05 --> repo05
repo ..> adp27
repo05 ..> adp05
adp27 --> esquema
adp05 --> esquema
@enduml
