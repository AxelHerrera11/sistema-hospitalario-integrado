---
title: "Actividad — ASII-03 Pacientes"
---
flowchart TD

A0((Inicio)) --> A1["Seleccionar operación"]

A1 --> A2{"¿Qué operación desea realizar?"}

A2 -- Registrar --> R1["Ingresar datos del paciente"]
R1 --> R2["Validar información"]

R2 --> R3{"¿Datos válidos?"}

R3 -- No --> R4["Mostrar errores de validación"]
R4 --> F1((Fin))

R3 -- Sí --> R5["Registrar paciente"]
R5 --> R6["Mostrar confirmación de registro"]
R6 --> F1

A2 -- Buscar --> B1["Ingresar criterio de búsqueda"]
B1 --> B2["Consultar pacientes"]

B2 --> B3{"¿Existen coincidencias?"}

B3 -- No --> B4["Informar que no existen resultados"]
B4 --> F2((Fin))

B3 -- Sí --> B5["Mostrar resultados"]
B5 --> B6{"¿Selecciona un paciente?"}

B6 -- No --> F2
B6 -- Sí --> B7["Mostrar detalle del paciente"]
B7 --> F2

A2 -- Actualizar --> U1["Seleccionar paciente"]
U1 --> U2["Verificar existencia del paciente"]

U2 --> U3{"¿Paciente existe?"}

U3 -- No --> U4["Mostrar paciente no encontrado"]
U4 --> F3((Fin))

U3 -- Sí --> U5["Ingresar nuevos datos"]
U5 --> U6["Validar nuevos datos"]

U6 --> U7{"¿Datos válidos?"}

U7 -- No --> U8["Mostrar errores sin modificar el registro"]
U8 --> F3

U7 -- Sí --> U9["Actualizar paciente"]
U9 --> U10["Mostrar confirmación de actualización"]
U10 --> F3
