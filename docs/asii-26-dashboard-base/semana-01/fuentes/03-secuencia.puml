@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #263238
skinparam sequence {
  ParticipantBackgroundColor #E3F2FD
  ParticipantBorderColor #1565C0
  ParticipantFontColor #17212B
  ActorBorderColor #263238
  ActorFontColor #17212B
  LifeLineBorderColor #263238
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B8860B
  FontColor #17212B
}
autonumber

actor "Usuario autenticado" as U
boundary "AppLayout/Navigation" as UI
control "Router Guard" as Guard
participant "Session/Auth" as Auth
control "DashboardController\n(API)" as API
database "API /resumen" as DB

U -> UI: Solicitar acceso al dashboard
UI -> Guard: Navegar a /dashboard
Guard -> Auth: Verificar token y tenant
alt Sin sesión o token inválido
  Auth --> Guard: No autorizado
  Guard --> UI: Redirigir /login (401)
  hnote over UI #FFEBEE: 401 - redirección a login
  UI --> U: Pantalla de login
else Sesión válida
  Guard -> Guard: Comprobar permiso del menú
  alt Sin permiso
    Guard --> UI: Redirigir /403 (403)
    hnote over UI #FFEBEE: 403 - sin permisos
    UI --> U: Pantalla 403
  else Autorizado
    UI -> API: GET /resumen (carga inicial)
    hnote over UI #FFF8E1: Estado: cargando
    API -> DB: Consultar resumen
    alt Error de consulta
      DB -x API: Error
      API --> UI: 500/timeout
      hnote over UI #FFEBEE: Estado: error con reintento
      UI --> U: Error + acción reintentar
    else Consulta responde
      DB --> API: Resumen
      alt Datos vacíos
        API --> UI: 200 con lista vacía
        hnote over UI #FFF8E1: Estado: vacío
        UI --> U: Sin datos para mostrar
      else Datos disponibles
        API --> UI: 200 con datos
        hnote over UI #E8F5E9: Estado: con datos
        UI --> U: Dashboard con resumen inicial
      end
    end
  end
end
@enduml
