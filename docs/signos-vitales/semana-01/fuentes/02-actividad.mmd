---
title: "Actividad — Captura de signos vitales, evaluación de umbrales y generación de alerta"
---
flowchart LR
  classDef ini fill:#1f2a44,stroke:#1f2a44
  classDef fin fill:#ffffff,stroke:#1f2a44,stroke-width:4px
  classDef ok fill:#e6f4ea,stroke:#2e7d32,color:#1b5e20
  classDef warn fill:#fff3e0,stroke:#e65100,color:#8a3a00
  classDef err fill:#fdecea,stroke:#c62828,color:#8e1c1c
  classDef dec fill:#fff8e1,stroke:#8a6d00
  classDef con fill:#ffffff,stroke:#1f2a44,stroke-width:2px,color:#1f2a44

  subgraph A["A · Capturar signos vitales y validar plausibilidad (UC-SV-01, 03, 07)"]
    direction TB
    i(( )):::ini --> a1["Médico abre el episodio del paciente<br/>y elige Registrar signos vitales (UC-SV-01)"]
    a1 --> a2["Capturar los signos medidos y la<br/>hora de medición (measured_at)"]
    a2 --> a3{"¿JWT, tenant y permiso<br/>signos_vitales.registrar?<br/>(UC-SV-07)"}:::dec
    a3 -- No --> a403["401/403 + denegación<br/>registrada por RBAC"]:::err
    a3 -- Sí --> a4{"¿Al menos un signo, valores<br/>numéricos y measured_at<br/>no futura?"}:::dec
    a4 -- No --> a422["422 Errores por campo"]:::err
    a4 -- Sí --> a5{"¿Valores dentro de los rangos<br/>fisiológicos plausibles y<br/>sistólica ≥ diastólica?"}:::dec
    a5 -- No --> arej["Rechazar (UC-SV-03)<br/>422 VITAL_SIGN_IMPLAUSIBLE<br/>(no se guarda nada)"]:::err
    a5 -- Sí --> a6{"¿Es médico asignado<br/>y activo en el episodio?<br/>(UC-SV-07)"}:::dec
    a6 -- No --> a403b["403 No es médico tratante"]:::err
    a6 -- Sí --> a7{"¿Episodio abierto y<br/>expediente del paciente<br/>abierto?"}:::dec
    a7 -- No --> a409["409 Episodio cerrado /<br/>expediente cerrado"]:::err
    a7 -- Sí --> a8["Medición aceptada"]
    a8 --> toB(("B")):::con
    a403 & a422 & arej & a403b & a409 --> f1((( ))):::fin
  end

  subgraph B["B · Evaluar umbrales y generar alerta (UC-SV-02, 04, 08)"]
    direction TB
    fromA(("A")):::con --> b1["Obtener el perfil de umbrales<br/>vigente para la edad del paciente<br/>(UC-SV-02)"]
    b1 --> b2{"¿Existe un perfil de<br/>umbrales aplicable?"}:::dec
    b2 -- No --> b3["BEGIN (conexión hospital):<br/>INSERT vital_signs (validated)<br/>+ INSERT local_access_audits<br/>signo_vital.sin_evaluacion (UC-SV-08)"]
    b3 --> b3ok["COMMIT · 201 Registrado con aviso<br/>THRESHOLDS_NOT_APPLICABLE:<br/>requiere evaluación clínica manual"]:::warn
    b2 -- Sí --> b4["Comparar cada signo con su umbral<br/>y calcular la severidad máxima<br/>(warning / critical)"]
    b4 --> b5{"¿Algún valor fuera<br/>de umbral?"}:::dec
    b5 -- No --> b6["BEGIN: INSERT vital_signs<br/>(validated) → COMMIT"]
    b6 --> b6ok["201 Signos registrados,<br/>sin alerta"]:::ok
    b5 -- Sí --> b7["BEGIN (conexión hospital):<br/>INSERT vital_signs (validated)<br/>+ INSERT critical_alerts (open,<br/>severidad, hallazgos) (UC-SV-04)<br/>+ INSERT local_access_audits (UC-SV-08)"]
    b7 --> b8{"¿Alerta y auditoría<br/>guardadas?"}:::dec
    b8 -- No --> b500["ROLLBACK: no se guarda<br/>el signo vital<br/>500 No hay valor anormal sin alerta"]:::err
    b8 -- Sí --> b9["COMMIT · 201 Signos registrados<br/>+ alerta con su severidad"]:::ok
    b9 --> b10["Encolar la notificación<br/>después del COMMIT"]
    b10 --> toC(("C")):::con
    b3ok & b6ok & b500 --> f2((( ))):::fin
  end

  subgraph C["C · Notificar la alerta a los médicos tratantes (UC-SV-05)"]
    direction TB
    fromB(("B")):::con --> c1["Job de notificación toma la alerta<br/>(asíncrono, fuera de la transacción)"]
    c1 --> c2["Obtener los médicos con<br/>care_assignment activo en el episodio"]
    c2 --> c3["Enviar notificación en la aplicación<br/>(bandeja y tiempo real): paciente,<br/>signo, valor y severidad"]
    c3 --> c4{"¿Envío exitoso?"}:::dec
    c4 -- Sí --> cok["Alerta notificada<br/>(se registra notified_at)"]:::ok
    c4 -- No --> c5{"¿Quedan reintentos?"}:::dec
    c5 -- Sí --> c6["Reintentar con espera<br/>exponencial"]
    c6 --> c3
    c5 -- No --> cfail["Registrar el fallo en el log:<br/>la alerta sigue abierta y visible<br/>en la bandeja de alertas"]:::warn
    cok & cfail --> f3((( ))):::fin
  end

  subgraph D["D · Reconocer la alerta clínica (UC-SV-06, 07, 08)"]
    direction TB
    k(( )):::ini --> d1["Médico abre la alerta desde la<br/>notificación o la bandeja y escribe<br/>la conducta tomada (UC-SV-06)"]
    d1 --> d2{"¿JWT, tenant y permiso<br/>alertas_clinicas.reconocer?<br/>(UC-SV-07)"}:::dec
    d2 -- No --> d403["401/403 + denegación<br/>registrada por RBAC"]:::err
    d2 -- Sí --> d6{"¿Registró la conducta<br/>tomada (nota obligatoria)?"}:::dec
    d6 -- No --> d422["422 Nota de reconocimiento<br/>obligatoria"]:::err
    d6 -- Sí --> d3{"¿La alerta existe<br/>en el tenant?"}:::dec
    d3 -- No --> d404["404 Alerta no encontrada"]:::err
    d3 -- Sí --> d4{"¿Es médico asignado y activo<br/>en el episodio de la alerta?<br/>(UC-SV-07)"}:::dec
    d4 -- No --> d403b["403 No es médico tratante"]:::err
    d4 -- Sí --> d5{"¿La alerta sigue abierta?"}:::dec
    d5 -- No --> d409["409 Alerta ya reconocida"]:::err
    d5 -- Sí --> d7["BEGIN (conexión hospital):<br/>status = acknowledged,<br/>acknowledged_by, acknowledged_at<br/>+ INSERT local_access_audits (UC-SV-08)"]
    d7 --> d8{"¿Auditoría registrada?"}:::dec
    d8 -- No --> d500["ROLLBACK<br/>500 No hay reconocimiento sin traza"]:::err
    d8 -- Sí --> dok["COMMIT · 200 Alerta reconocida"]:::ok
    d403 & d404 & d403b & d409 & d422 & d500 & dok --> f4((( ))):::fin
  end

  %% Los conectores (B) y (C) enlazan las particiones según la notación UML.
  %% Enlaces invisibles: solo ordenan las particiones de izquierda a derecha
  A ~~~ B ~~~ C ~~~ D
