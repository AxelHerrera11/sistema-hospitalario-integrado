@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #263238
skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #17212B
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B8860B
  FontColor #17212B
}

class ReportesService {
  + exportar(id: string, filtros: array, formato: string): string
  - filtrar(id: string, consulta, filtros): consulta
  - exportarCsv(filas): string
  - exportarPdf(filas): string
  .. if id == 'citas' / 'ocupacion' ..
  .. if filtros['status'] / ['ward_id'] ..
  .. if formato == 'csv' / 'pdf' ..
}

note right of ReportesService
  Un reporte, filtro o formato nuevo
  obliga a MODIFICAR esta clase.
  Riesgo de romper lo ya probado.
  ==> Incumple OCP.
end note

class "appointments" as A <<tabla>>
class "wards / beds / bed_stays" as B <<tabla>>
class "care_episodes" as C <<tabla>>

ReportesService --> A : consulta
ReportesService --> B : consulta
ReportesService --> C : consulta
@enduml
